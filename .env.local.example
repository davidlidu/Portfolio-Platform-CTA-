# .env.local.example
# Copiar este archivo como .env.local y completar los valores

# Base de datos
DATABASE_URL="postgresql://portfolio_user:securepassword@localhost:5432/portfolio_platform"

# Auth - Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIA_ESTO_genera_con_openssl_rand_base64_32"
NEXTAUTH_URL="https://tuportafolio.calltoactionplus.com"

# Credenciales admin
ADMIN_EMAIL="tecnologia@calltoactionplus.com"
ADMIN_PASSWORD="Admin123**"

# App
NEXT_PUBLIC_BASE_URL="https://tuportafolio.calltoactionplus.com"

# SMTP (invitaciones de usuarios por correo)
# Para Gmail: SMTP_USER = tu correo, SMTP_PASSWORD = una "Contraseña de aplicación"
# (Google Account > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="tucorreo@gmail.com"
SMTP_PASSWORD="app_password_de_16_caracteres"
SMTP_FROM="TapHub <tucorreo@gmail.com>"

# GoHighLevel (GHL) - conexión global para enviar leads capturados.
# La vinculación se enciende/apaga por portafolio desde el panel (toggle "Vincular
# a GoHighLevel"); estas credenciales son las mismas para todos.
# GHL_API_KEY: token de una "Private Integration" de la location (Settings >
#   Private Integrations en GHL). Se envía como "Bearer <token>".
# GHL_LOCATION_ID: ID de la location/sub-cuenta.
# GHL_PORTFOLIO_FIELD_KEY: (opcional) "Unique Key" del campo personalizado en GHL
#   donde se guarda el identificador del portafolio. Por defecto "portfolio_slug"
#   (créalo en GHL: Settings > Custom Fields). El identificador también viaja como tag.
# GHL_DEFAULT_TAG: (opcional) tag que se envía SIEMPRE en todos los portafolios,
#   además del identificador propio de cada uno. Por defecto "taphub-lead".
# GHL_API_VERSION: (opcional) versión de la API. Por defecto "2021-07-28".
GHL_API_KEY=""
GHL_LOCATION_ID=""
GHL_PORTFOLIO_FIELD_KEY="portfolio_slug"
GHL_DEFAULT_TAG="taphub-lead"
GHL_API_VERSION="2021-07-28"
