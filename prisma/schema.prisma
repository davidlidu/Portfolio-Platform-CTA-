// prisma/schema.prisma
// Esquema de base de datos para la plataforma de portafolios

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Portfolio {
  id          String   @id @default(cuid())
  slug        String   @unique // ej: "juan-pablo-rojas"
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Sección Hero
  heroName     String // Nombre completo (puede tener \n)
  heroBadge    String @default("Disponible para proyectos")
  heroRole     String // Rol/título profesional
  heroPhotoUrl String? // URL foto de perfil

  // Redes sociales (JSON array)
  // Estructura: [{ icon, label, url }]
  socials Json @default("[]")

  // Sección Intro
  introQuote     String @db.Text
  introTags      String[] // Array de strings ["AI", "Growth", ...]
  introCta1Label String   @default("Agendar conversación")
  introCta2Label String   @default("Explorar proyectos")

  // Sección Servicios
  servicesLabel       String @default("// Servicios")
  servicesTitle       String @default("Cómo genero valor")
  servicesDescription String @db.Text

  // Pilares de servicios (JSON array)
  // Estructura: [{ icon, title, description, items: string[] }]
  servicePillars Json @default("[]")

  // Sección Enfoque
  approachLabel       String @default("// Mi enfoque")
  approachTitle       String
  approachDescription String @db.Text
  approachSteps       String[] // Array de strings

  // Sección Contacto
  contactLabel       String @default("// Conectemos")
  contactTitle       String @default("¿Tienes un proyecto en mente?")
  contactDescription String @db.Text
  contactCta1Label   String @default("Agendar conversación")
  contactCta2Label   String @default("Guardar contacto")

  // WhatsApp CTA global
  whatsappNumber  String? // ej: "573001234567"
  whatsappMessage String? // Mensaje predefinido

  // Footer
  footerInitials String @default("JP")
  footerName     String

  // Tema de color del portafolio público
  paletteId String @default("emerald")

  // Idioma del portafolio público
  language  String @default("es")

  // Formulario de acceso (LeadGate): bloquea el contenido hasta capturar datos.
  // Se puede encender/apagar por portafolio desde la configuración.
  leadGateEnabled Boolean @default(true)

  // Proyectos
  projects Project[]

  // Leads capturados por el formulario de acceso
  leads Lead[]

  // Tarjetas NFC asociadas a este portafolio
  cards NfcCard[]

  // Aperturas / visitas registradas (analítica)
  visits Visit[]

  // Usuarios con acceso a editar este portafolio
  users User[]
}

// Usuario con acceso al panel. role "admin" = acceso global (no usa DB, viene
// del entorno); en DB solo guardamos usuarios de portafolio (role "portfolio")
// que solo pueden editar su propio portafolio. Se crean por invitación.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  passwordHash String? // null hasta que acepta la invitación
  role         String  @default("portfolio") // "admin" | "portfolio"

  portfolioId String?
  portfolio   Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  // Invitación pendiente
  inviteToken   String?   @unique
  inviteExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
}

model Project {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  title        String
  description  String   @db.Text
  tags         String[]
  thumbnailUrl String?
  images       String[] // Array de URLs (galería)
  projectUrl   String?
  order        Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  fullName    String // Nombre completo ingresado
  contact     String // Valor crudo ingresado (celular o correo)
  email       String? // Correo detectado (si aplica)
  phone       String? // Celular detectado (si aplica)
  contactType String  @default("unknown") // "email" | "phone" | "unknown"

  // Atribución: tarjeta NFC y visitante anónimo que generó este lead.
  cardId    String?
  card      NfcCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  visitorId String?

  createdAt DateTime @default(now())

  @@index([portfolioId, createdAt])
  @@index([cardId])
}

// Tarjeta NFC física. Su `id` es el token que viaja en la URL grabada
// (ej. https://dominio/t/<id>). Se generan desde el panel de cada portafolio.
model NfcCard {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  label    String  @default("") // Etiqueta interna, ej. "Tarjeta oficina"
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  visits Visit[]
  leads  Lead[]

  @@index([portfolioId])
}

// Apertura registrada del portafolio. cardId != null => llegó por una tarjeta NFC.
model Visit {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  cardId String?
  card   NfcCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  visitorId String? // Cookie anónima para únicos y conversión tap->lead
  source    String  @default("direct") // "nfc" | "direct"
  device    String  @default("unknown") // "mobile" | "desktop" | "tablet"
  os        String?
  browser   String?
  referrer  String?

  createdAt DateTime @default(now())

  @@index([portfolioId, createdAt])
  @@index([cardId])
  @@index([visitorId])
}
